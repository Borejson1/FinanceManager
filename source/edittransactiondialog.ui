   <string notr="true">
QWidget {
    background-color: #f5f6fa;
    color: #2f3542;
}
QLabel {
    font-weight: bold;
    font-size: 13px;
    background: transparent;
}
QLineEdit, QComboBox, QDateEdit, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #ced6e0;
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 13px;
}
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QDoubleSpinBox:focus {
    border: 1px solid #747d8c;
    background-color: #fcfcfd;
}
QComboBox::drop-down, QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #ced6e0;
    background-color: #f1f2f6;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}
QComboBox::down-arrow, QDateEdit::down-arrow {
    image: none;
}
QPushButton {
    background-color: #dfe4ea;
    border: 1px solid #ced6e0;
    border-radius: 5px;
    padding: 8px 15px;
    font-weight: bold;
    font-size: 13px;
    min-width: 80px;
}
QPushButton:hover {
    background-color: #ced6e0;
    border: 1px solid #a4b0be;
}
QPushButton:pressed {
    background-color: #a4b0be;
    color: #ffffff;
}
/* KALENDARZ */
QCalendarWidget QWidget#qt_calendar_navigationbar { background-color: #f1f2f6; border-bottom: 1px solid #ced6e0; }
QCalendarWidget QToolButton { font-weight: bold; font-size: 13px; background-color: transparent; border: none; padding: 5px; border-radius: 4px; }
QCalendarWidget QToolButton:hover { background-color: #dfe4ea; }
QCalendarWidget QToolButton:pressed { background-color: #ced6e0; }
QCalendarWidget QMenu { background-color: #ffffff; border: 1px solid #ced6e0; }
QCalendarWidget QMenu::item:selected { background-color: #a4b0be; color: white; }
QCalendarWidget QSpinBox { background-color: #ffffff; border: 1px solid #ced6e0; border-radius: 3px; }
QCalendarWidget QAbstractItemView:enabled { background-color: #ffffff; selection-background-color: #a4b0be; selection-color: white; outline: none; }
QCalendarWidget QAbstractItemView:disabled { color: #ced6e0; }
